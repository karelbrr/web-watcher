{
  "name": "web-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --build && npm run lint",
    "lint": "eslint .",
    "ensure-indexes": "tsx scripts/ensure-indexes.ts",
    "dev:api": "npm run dev --workspace services/api",
    "dev:worker": "npm run dev --workspace services/worker",
    "dev:fetcher": "npm run dev --workspace services/fetcher",
    "dev:notifier": "npm run dev --workspace services/notifier"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
